# Copy to .env only if you want to override the defaults baked into compose.yaml.
# Nothing here is secret - this stack is local-only.

# Reachable from your Mac. Inside compose the services use kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29098
DATABASE_URL=postgresql+asyncpg://fraud:fraud@localhost:5436/fraud

# Topics (created on API startup with TOPIC_PARTITIONS partitions each)
TOPIC_PAYMENT_EVENTS=payment.events
TOPIC_FRAUD_EVENTS=fraud.events
TOPIC_PARTITIONS=3

# --- Risk rules -------------------------------------------------------------
# Rule 1: N payments by one user inside a window
RULE_FREQUENCY_COUNT=20
RULE_FREQUENCY_WINDOW_SECONDS=30
RULE_FREQUENCY_SCORE=40

# Rule 2: single large payment
RULE_LARGE_AMOUNT=5000
RULE_LARGE_AMOUNT_SCORE=20

# Rule 3: repeated blocked payments by the same user
RULE_BLOCKED_COUNT=5
RULE_BLOCKED_WINDOW_SECONDS=300
RULE_BLOCKED_SCORE=20

# Rule 4: country differs from the previous payment, within this window
RULE_COUNTRY_WINDOW_SECONDS=3600
RULE_COUNTRY_SCORE=30

# Rule 5: device never seen before for this user
RULE_NEW_DEVICE_SCORE=10

# score >= FRAUD_THRESHOLD  =>  blocked / fraud.detected
FRAUD_THRESHOLD=70

LOG_JSON=false
